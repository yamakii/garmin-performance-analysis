result/

# Keep directory structure
!data/raw/.gitkeep
!data/performance/.gitkeep
!data/precheck/.gitkeep
!data/cache/.gitkeep
!data/database/.gitkeep
!data/logs/.gitkeep
!data/archive/.gitkeep

# Project specific - Temporary files
tmp/*
!tmp/.gitkeep

# Project specific - Local settings
# `**/` is required: a pattern containing a slash is anchored to this .gitignore's
# directory, so the bare `.claude/...` forms only matched the repo root and left
# packages/*/.claude/ local settings showing as untracked (#882). The patterns stay
# narrow (settings.local.json / tasks/ / worktrees/) so tracked .claude assets --
# agents/, skills/, rules/, workflows/, hooks/ -- are never ignored.
# `.mcp.json` has no slash, so it already matches at every level; leave it as is.
**/.claude/settings.local.json
**/.claude/tasks/
**/.claude/worktrees/
.mcp.json

# Package-level data (runtime-generated)
packages/garmin-mcp-server/data/

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Serena MCP
.serena/
